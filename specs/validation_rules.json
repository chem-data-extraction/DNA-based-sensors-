{
  "validation_version": "0.1.0",
  "rules": [
    {
      "rule_id": "files_exist_core",
      "target": "repository",
      "rule_type": "required_files",
      "severity": "error",
      "description": "Core project files must exist"
    },
    {
      "rule_id": "dataset_csv_exists",
      "target": "data/processed/dataset.csv",
      "rule_type": "file_exists",
      "severity": "error",
      "description": "Final processed dataset CSV must exist"
    },
    {
      "rule_id": "columns_match_schema",
      "target": "data/processed/dataset.csv",
      "rule_type": "schema_columns",
      "severity": "error",
      "description": "Dataset columns must match specs/dataset_schema.json"
    },
    {
      "rule_id": "record_id_not_null",
      "target": "record_id",
      "rule_type": "not_null",
      "severity": "error",
      "description": "Every row must have a non-empty record_id"
    },
    {
      "rule_id": "record_id_unique",
      "target": "record_id",
      "rule_type": "unique",
      "severity": "error",
      "description": "record_id values must be unique"
    },
    {
      "rule_id": "source_id_not_null",
      "target": "source_id",
      "rule_type": "not_null",
      "severity": "error",
      "description": "Every row must have source_id"
    },
    {
      "rule_id": "source_id_in_source_map",
      "target": "source_id",
      "rule_type": "foreign_key",
      "severity": "warning",
      "description": "Every source_id should be documented in specs/source_map.json"
    },
    {
      "rule_id": "measurement_value_numeric",
      "target": "measurement_value",
      "rule_type": "numeric_or_null",
      "severity": "error",
      "description": "measurement_value must be numeric or blank"
    },
    {
      "rule_id": "normalized_value_numeric",
      "target": "normalized_value_nM",
      "rule_type": "numeric_or_null",
      "severity": "error",
      "description": "normalized_value_nM must be numeric or blank"
    },
    {
      "rule_id": "confidence_allowed",
      "target": "extraction_confidence",
      "rule_type": "allowed_values",
      "severity": "warning",
      "description": "Confidence should be high, medium, low, unknown, or blank"
    }
  ]
}
